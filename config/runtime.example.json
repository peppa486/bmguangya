{
  "dry_run": true,
  "state_path": "/var/lib/bmguangya/state.json",
  "catalog_path": "/var/lib/bmguangya/bangumi-collections-catalog.json",
  "tracked_collection_types": [1, 2, 3, 4, 5],
  "download_collection_types": [3, 1, 2],
  "max_new_cloud_tasks_per_run": 40,
  "daily_cloud_task_quota": 1000,
  "max_batch_episode_span": 52,
  "bangumi": {
    "base_url": "https://api.bgm.tv",
    "username": "",
    "access_token": "",
    "user_agent": "bmguangya/1.0 (contact: contact@example.com)",
    "timeout_seconds": 45,
    "page_size": 100
  },
  "alist": {
    "base_url": "http://127.0.0.1:5244",
    "api_base": "http://127.0.0.1:5244",
    "public_url": "https://alist.example.com",
    "root": "/guangya/Anime",
    "stream_mount": "guangya",
    "username": "",
    "password": "",
    "token": "",
    "database_path": "/var/lib/alist/data/data.db",
    "guangya_mount_path": "/guangya",
    "timeout_seconds": 60,
    "max_workers": 4,
    "max_depth": 32,
    "max_directories": 20000,
    "page_size": 100
  },
  "guangya": {
    "config_path": "/etc/bmguangya/guangya.json",
    "root_dir": "Anime",
    "readonly_request_timeout_seconds": 45,
    "readonly_max_attempts": 2,
    "cloud_task_scan_timeout_seconds": 900
  },
  "mikan": {
    "base_url": "https://mikanani.me",
    "user_agent": "bmguangya/1.0",
    "max_candidates_per_show": 6,
    "subject_overrides": {}
  },
  "filters": {
    "preferred_subgroups": [
      "喵萌奶茶屋&LoliHouse", "喵萌奶茶屋", "LoliHouse", "千夏字幕组",
      "桜都字幕组", "SweetSub", "澄空学园&动漫国字幕组", "雪飘工作室",
      "豌豆字幕组", "幻樱字幕组", "风之圣殿字幕组", "北宇治字幕组",
      "悠哈璃羽字幕社", "霜庭云花Sub", "绿茶字幕组", "ANi",
      "Nekomoe kissaten", "Lilith-Raws", "Skymoon-Raws"
    ],
    "require_keywords_any": ["简", "CHS", "GB", "简体", "简中"],
    "exclude_keywords": ["BIG5", "粤语", "外挂", "繁体", "CHT", "繁中", "Traditional"],
    "prefer_resolutions": ["1080p", "2160p", "720p"]
  },
  "inventory": {
    "directory_max_attempts": 3,
    "output": "/var/lib/bmguangya/library.json",
    "progress_path": "/var/lib/bmguangya/library.progress.json",
    "progress_interval_seconds": 15,
    "freshness_ttl_seconds": 900,
    "max_workers": 3,
    "max_runtime_seconds": 2700,
    "cloud_source": "guangya_direct"
  },
  "cache": {
    "path": "/var/lib/bmguangya/bangumi-episodes-cache.json",
    "ttl_seconds": 86400
  },
  "inventory_path": "/var/lib/bmguangya/library.json",
  "strm": {
    "include_review_directories": false
  },
  "media_root": "/opt/jellyfin/media/Anime",
  "archive_root": "/var/lib/bmguangya/archive",
  "report_path": "/var/lib/bmguangya/strm-sync-report.json",
  "progress_path": "/var/lib/bmguangya/sync-progress.json",
  "pipeline_lock_path": "/var/lib/bmguangya/pipeline.lock",
  "reconcile": {
    "report": "/var/lib/bmguangya/reconcile-report.json",
    "organize_unassigned": false
  },
  "network_timeout_seconds": 30,
  "jellyfin": {
    "base_url": "http://127.0.0.1:8096",
    "token": "",
    "username": "jellyfin-user",
    "db_path": "/opt/jellyfin/config/data/jellyfin.db",
    "timeout_seconds": 30
  }
}
