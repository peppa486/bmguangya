[Unit]
Description=Safely reconcile uniquely identified cloud season bundles and episode paths
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/bmguangya/config.json
ConditionPathExists=/var/lib/bmguangya/library.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
StateDirectory=bmguangya
StateDirectoryMode=0750
WorkingDirectory=/opt/bmguangya
ExecStart=/opt/bmguangya/.venv/bin/python /opt/bmguangya/scripts/reconcile_cloud_library.py --config /etc/bmguangya/config.json --inventory /var/lib/bmguangya/library.json --report /var/lib/bmguangya/reconcile-report.json --apply
TimeoutStartSec=180min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/bmguangya
ReadOnlyPaths=/etc/bmguangya/config.json

[Install]
WantedBy=multi-user.target
